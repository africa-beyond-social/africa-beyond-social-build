# Africa & Beyond Social — Live Centre
# Copy these into your Vercel project Environment Variables.

# Server-side YouTube Data API key. Keep this secret; do not prefix it with NEXT_PUBLIC_.
YOUTUBE_API_KEY=

# Africa & Beyond TV channel ID used for automatic live/upcoming detection.
# The app has the current channel ID as a fallback, but setting it explicitly is recommended.
YOUTUBE_CHANNEL_ID=UC4c_VhltMjJ3lqkQREjnzfQ

# Optional public channel ID override used by the embedded player.
NEXT_PUBLIC_LIVE_YOUTUBE_CHANNEL_ID=UC4c_VhltMjJ3lqkQREjnzfQ

# Optional: specific YouTube video ID to feature when API detection is unavailable.
NEXT_PUBLIC_LIVE_YOUTUBE_VIDEO_ID=
NEXT_PUBLIC_LIVE_TITLE=Africa & Beyond TV — Live

# Optional fallback event. The database is preferred once live_events is populated.
NEXT_PUBLIC_LIVE_EVENT_TITLE=Next Africa & Beyond live event
NEXT_PUBLIC_LIVE_EVENT_START=
NEXT_PUBLIC_LIVE_EVENT_LOCATION=
